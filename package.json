{
  "name": "busybar-notion-tasks",
  "private": true,
  "version": "1.0.1",
  "description": "BUSY Bar app: today's Notion tasks on the front screen, closed with a button",
  "author": "avachadev",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build": "busy-cli build",
