  "engines": {
    "node": ">=24 <26"
  },
  "devDependencies": {
    "@busy-app/cli": "^0.6.0",
    "typescript": "~6.0.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.21.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/avachadev/busybar-notion-tasks.git"
  }
